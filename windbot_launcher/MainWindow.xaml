<Window x:Class="WindBotLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧠 WindBot Launcher — YGO AI Platform" Height="720" Width="1100"
        Background="{DynamicResource BgPrimary}" WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900"
        Icon="pack://application:,,,/app_icon.png">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" Padding="16,12" CornerRadius="0,0,12,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="WindBot Launcher" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="YGO AI Research Platform · v2.2" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtClock" Foreground="{StaticResource TextSecondary}"
                               FontSize="14" VerticalAlignment="Center" Text="00:00:00"/>
                    <TextBlock x:Name="TxtStatus" Foreground="{StaticResource SuccessColor}"
                               FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" Text="🟢 พร้อม"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="16,12" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: PLAY -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎮 " FontSize="14"/>
                        <TextBlock Text="เล่น" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Controls -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="⚙️ ตั้งค่าการเล่น" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                            <!-- Bot Mode -->
                            <TextBlock Text="โหมด" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <RadioButton x:Name="RbSingleBot" Content="Bot เดียว" Foreground="{StaticResource TextPrimary}"
                                             IsChecked="True" Margin="0,0,12,0" GroupName="BotMode"/>
                                <RadioButton x:Name="RbTwoBots" Content="Bot vs Bot" Foreground="{StaticResource TextPrimary}"
                                             GroupName="BotMode" Checked="RbTwoBots_Checked" Unchecked="RbTwoBots_Unchecked"/>
                            </StackPanel>

                            <!-- Bot Deck -->
                            <TextBlock Text="เด็คบอท A" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <ComboBox x:Name="CbBotDeck" Style="{StaticResource DarkComboBox}" Margin="0,4,0,12"
                                      IsEditable="True" Text="2026_Goldlord"/>

                            <!-- Opponent Deck (visible only for two-bot mode) -->
                            <TextBlock x:Name="LblOpponentDeckTitle" Text="เด็คคู่ต่อสู้" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" Visibility="Collapsed"/>
                            <ComboBox x:Name="CbOpponentDeck" Style="{StaticResource DarkComboBox}" Margin="0,4,0,12"
                                      IsEditable="True" Text="2026_Goldlord" Visibility="Collapsed"/>

                            <!-- Host/Port -->
                            <TextBlock Text="การเชื่อมต่อ" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <Grid Margin="0,4,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtHost" Text="127.0.0.1" Style="{StaticResource DarkTextBox}"
                                         Grid.Column="0"/>
                                <TextBox x:Name="TxtPort" Text="7911" Style="{StaticResource DarkTextBox}"
                                         Grid.Column="2"/>
                            </Grid>

                            <!-- Buttons -->
                            <Button x:Name="BtnStartBot" Content="▶ เริ่มบอท" Style="{StaticResource PrimaryButton}"
                                    Margin="0,8,0,8" Click="BtnStartBot_Click" Height="40"/>
                            <Button x:Name="BtnStopBot" Content="⏹ หยุดบอท" Style="{StaticResource DangerButton}"
                                    IsEnabled="False" Click="BtnStopBot_Click" Height="40"/>
                            <TextBlock x:Name="TxtBotStatus" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <Separator Margin="0,16,0,16" Background="#444466" Height="1"/>

                            <!-- Quick Info -->
                            <TextBlock Text="📊 ข้อมูลด่วน" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtQuickStats" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- RIGHT: Console Log -->
                        <Border Grid.Column="1" Background="#12121F" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="📟 Console Output" Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                    <Button Content="ล้าง" Foreground="{StaticResource AccentColor}"
                                            Background="Transparent" BorderThickness="0" FontSize="11"
                                            Click="BtnClearConsole_Click" HorizontalAlignment="Right"
                                            Cursor="Hand" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtConsole" Background="Transparent" Foreground="#A0D0A0"
                                             FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Disabled"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: TRAIN -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏋️ " FontSize="14"/>
                        <TextBlock Text="เทรน" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Training Config -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="⚙️ ตั้งค่าการเทรน" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                            <TextBlock Text="เด็คหลัก (ต้องมี Expert_ หรือ Neural_ prefix)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <ComboBox x:Name="CbTrainDeck" Style="{StaticResource DarkComboBox}" Margin="0,4,0,8" IsEditable="True">
                                <ComboBoxItem Content="Neural"/>
                            </ComboBox>

                            <TextBlock Text="คู่ต่อสู้ (คั่นด้วย ,)" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <TextBox x:Name="TxtTrainOpponents" Text="Altergeist,Salamangreat,DarkMagician,Blue-Eyes"
                                     Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="จำนวนเกม" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBox x:Name="TxtTrainGames" Text="30" Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Epochs" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBox x:Name="TxtTrainEpochs" Text="15" Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Learning Rate" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBox x:Name="TxtTrainLR" Text="0.05" Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Workers" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                    <TextBox x:Name="TxtTrainWorkers" Text="4" Style="{StaticResource DarkTextBox}" Margin="0,4,0,8"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="ChkAutoDeploy" Content="Deploy weights อัตโนมัติหลังเทรน"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,12,0,4"/>

                            <Button x:Name="BtnStartTrain" Content="▶ เริ่มเทรน" Style="{StaticResource PrimaryButton}"
                                    Margin="0,12,0,8" Click="BtnStartTrain_Click" Height="40"/>
                            <Button x:Name="BtnStopTrain" Content="⏹ หยุดเทรน" Style="{StaticResource DangerButton}"
                                    IsEnabled="False" Click="BtnStopTrain_Click" Height="40"/>

                            <ProgressBar x:Name="PbTrainProgress" Height="4" Margin="0,16,0,0"
                                         IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                         Foreground="{StaticResource AccentColor}" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtTrainProgress" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- RIGHT: Training Console -->
                        <Border Grid.Column="1" Background="#12121F" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🏋️ Training Output" Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtTrainOutput" Background="Transparent" Foreground="#C0C0E0"
                                             FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: DASHBOARD -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 " FontSize="14"/>
                        <TextBlock Text="Dashboard" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="BtnRefreshDashboard" Content="🔄 Refresh" Style="{StaticResource PrimaryButton}"
                                    Click="BtnRefreshDashboard_Click" Height="32" Padding="12,4" FontSize="12"/>
                            <TextBlock x:Name="TxtDashboardLastRefresh" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                            <!-- Training Runs -->
                            <TabItem Header="Training Runs">
                                <DataGrid x:Name="DgTrainingRuns" IsReadOnly="True" AutoGenerateColumns="True"
                                          Margin="0,8,0,0"/>
                            </TabItem>
                            <!-- Elo History -->
                            <TabItem Header="ELO History">
                                <DataGrid x:Name="DgEloHistory" IsReadOnly="True" AutoGenerateColumns="True"
                                          Margin="0,8,0,0"/>
                            </TabItem>
                            <!-- Deck Matchups -->
                            <TabItem Header="Matchups">
                                <DataGrid x:Name="DgMatchups" IsReadOnly="True" AutoGenerateColumns="True"
                                          Margin="0,8,0,0"/>
                            </TabItem>
                            <!-- Deck Stats -->
                            <TabItem Header="Deck Stats">
                                <DataGrid x:Name="DgDeckStats" IsReadOnly="True" AutoGenerateColumns="True"
                                          Margin="0,8,0,0"/>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: DATASETS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " FontSize="14"/>
                        <TextBlock Text="Datasets" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Deck List -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="📂 เลือกเด็ค" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                            <ListBox x:Name="LbDatasetDecks" Background="{StaticResource BgCard}"
                                     Foreground="{StaticResource TextPrimary}" BorderBrush="#444466"
                                     SelectionChanged="LbDatasetDecks_SelectionChanged"/>
                            <Separator Margin="0,12" Background="#444466"/>

                            <TextBlock x:Name="TxtDatasetInfo" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" TextWrapping="Wrap"/>
                            <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}"
                                    Margin="0,8,0,0" Height="28" FontSize="11" Padding="8,4"
                                    Click="BtnRefreshDatasets_Click"/>
                        </StackPanel>

                        <!-- Dataset Preview -->
                        <Border Grid.Column="1" Background="#12121F" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtDatasetFileTitle" Text="เลือกไฟล์ทางซ้าย"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ListBox x:Name="LbDatasetFiles" Grid.Row="1" Background="{StaticResource BgCard}"
                                         Foreground="{StaticResource TextPrimary}" BorderBrush="#444466"
                                         MaxHeight="120" Margin="0,0,0,8"
                                         SelectionChanged="LbDatasetFiles_SelectionChanged"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtDatasetPreview" Background="Transparent" Foreground="#A0D0A0"
                                             FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 5: MODELS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧬 " FontSize="14"/>
                        <TextBlock Text="Models" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="🔄 Refresh" Style="{StaticResource PrimaryButton}"
                                    Click="BtnRefreshModels_Click" Height="32" Padding="12,4" FontSize="12"/>
                            <Button x:Name="BtnDeployWeights" Content="📦 Deploy to Game_EDOPro" Style="{StaticResource PrimaryButton}"
                                    Margin="8,0,0,0" Height="32" Padding="12,4" FontSize="12"
                                    Click="BtnDeployWeights_Click"/>
                            <TextBlock x:Name="TxtDeployStatus" Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- Training Models -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <GroupBox Header="📊 Training Models (YGO_AI_PLATFORM/models/)" Foreground="{StaticResource TextPrimary}"
                                          BorderBrush="#444466" Margin="0,0,0,12">
                                    <DataGrid x:Name="DgTrainModels" IsReadOnly="True" AutoGenerateColumns="True"
                                              MaxHeight="200"/>
                                </GroupBox>

                                <GroupBox Grid.Row="1" Header="🎮 Deployed Models (Game_EDOPro/WindBot/models/)" Foreground="{StaticResource TextPrimary}"
                                          BorderBrush="#444466" Margin="0,0,0,12">
                                    <DataGrid x:Name="DgDeployedModels" IsReadOnly="True" AutoGenerateColumns="True"
                                              MaxHeight="200"/>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Header="🔍 Weight Preview" Foreground="{StaticResource TextPrimary}"
                                          BorderBrush="#444466">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <TextBox x:Name="TxtWeightPreview" Background="Transparent" Foreground="#A0D0A0"
                                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                                 BorderThickness="0"/>
                                    </ScrollViewer>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 6: TOOLS -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧 " FontSize="14"/>
                        <TextBlock Text="Tools" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>
                <Border Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Action Buttons -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="🔧 เครื่องมือระบบ" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                            <!-- GUI เดิม -->
                            <TextBlock Text="GUI" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <Button x:Name="BtnOpenTrainGui" Content="🖥 เปิด Train GUI เดิม"
                                    Style="{StaticResource PrimaryButton}" Height="36"
                                    Margin="0,4,0,12" Click="BtnOpenTrainGui_Click"/>

                            <Separator Background="#444466" Height="1" Margin="0,0,0,12"/>

                            <!-- VPS -->
                            <TextBlock Text="VPS Packaging" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <Button x:Name="BtnBuildVps" Content="📦 Build &amp; Package VPS"
                                    Style="{StaticResource PrimaryButton}" Height="36"
                                    Margin="0,4,0,8" Click="BtnBuildVps_Click"/>
                            <Button x:Name="BtnCopyDesktop" Content="🖥 Copy VPS to Desktop"
                                    Style="{StaticResource PrimaryButton}" Height="36"
                                    Margin="0,0,0,12" Click="BtnCopyDesktop_Click"/>

                            <Separator Background="#444466" Height="1" Margin="0,0,0,12"/>

                            <!-- Testing -->
                            <TextBlock Text="Testing" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <Button x:Name="BtnRunTests" Content="🧪 Run E2E Tests"
                                    Style="{StaticResource PrimaryButton}" Height="36"
                                    Margin="0,4,0,8" Click="BtnRunTests_Click"/>
                            <Button x:Name="BtnRunHeadless" Content="⚡ Run Headless Simulation"
                                    Style="{StaticResource PrimaryButton}" Height="36"
                                    Margin="0,0,0,12" Click="BtnRunHeadless_Click"/>

                            <Separator Background="#444466" Height="1" Margin="0,0,0,12"/>

                            <!-- Utilities -->
                            <TextBlock Text="Utilities" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <Button x:Name="BtnDeckAuditor" Content="🔍 Deck Auditor (Python)"
                                    Style="{StaticResource PrimaryButton}" Height="36"
                                    Margin="0,4,0,8" Click="BtnDeckAuditor_Click"/>
                            <Button x:Name="BtnCleanData" Content="🗑 Clean Datasets &amp; Logs"
                                    Style="{StaticResource DangerButton}" Height="36"
                                    Margin="0,0,0,0" Click="BtnCleanData_Click"/>
                        </StackPanel>

                        <!-- RIGHT: Tools Output Console -->
                        <Border Grid.Column="1" Background="#12121F" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="📟 Tools Output" Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                    <Button Content="ล้าง" Foreground="{StaticResource AccentColor}"
                                            Background="Transparent" BorderThickness="0" FontSize="11"
                                            Click="BtnClearTools_Click" Cursor="Hand" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="TxtToolsOutput" Background="Transparent" Foreground="#D0C0FF"
                                             FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                             BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Disabled"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" Padding="12,8" CornerRadius="12,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtFooter" Foreground="{StaticResource TextSecondary}"
                           FontSize="11" Text="พร้อมทำงาน"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
