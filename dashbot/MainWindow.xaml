<Window x:Class="dashbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dashbot"
        mc:Ignorable="d"
        Title="YGO Bot Launcher" Height="760" Width="1180" MinHeight="680" MinWidth="1020"
        Background="#080D1A" TextElement.Foreground="#111111"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Icon="dashbot.ico">

    <Window.Resources>
        <!-- Classic Elegant TextBox (Native WPF Template without clipping) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Elegant Charcoal Dark Button (WinForm Classic) -->
        <Style x:Key="ClassicCharcoalBtn" TargetType="Button">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#222222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                    <Setter Property="BorderBrush" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#111111"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary White Button -->
        <Style x:Key="SecondaryWhiteBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Filter Pill RadioButton (Elegant White/Charcoal) -->
        <Style x:Key="CategoryFilterPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                    <Setter Property="Foreground" Value="#111111"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#222222"/>
                    <Setter Property="BorderBrush" Value="#222222"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bot Assignment Toggle RadioButton -->
        <Style x:Key="BotSelectorPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#111111"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="#0284C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Faded Cosmic Background Layer -->
        <Image Source="bg.jpg" Stretch="UniformToFill" Opacity="0.22" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Ambient Vignette Tint Overlay -->
        <Border>
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#00080D1A" Offset="0.0"/>
                    <GradientStop Color="#40080D1A" Offset="0.75"/>
                    <GradientStop Color="#85050812" Offset="1.0"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Workspace (Layered Above Background) -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Bar (White Elegant Panel) -->
            <Border Grid.Row="0" Background="#F8FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="16,12" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.18"/>
                </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="YGO Bot Launcher" FontSize="20" FontWeight="Bold" Foreground="#111111"/>
                        <Border Background="#222222" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="EDOPro Suite" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Standalone client connecting WindBot to EDOPro room" FontSize="11.5" Foreground="#666666"/>
                        <TextBlock Text=" | " FontSize="11.5" Foreground="#CCCCCC" Margin="6,0"/>
                        <TextBlock Text="WindBot by IceYgo" FontSize="11.5" FontWeight="SemiBold" Foreground="#0284C7"/>
                        <TextBlock Text=" | " FontSize="11.5" Foreground="#CCCCCC" Margin="6,0"/>
                        <TextBlock Text="Custom Deck By Jaynesiz" FontSize="11.5" FontWeight="SemiBold" Foreground="#D97706"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#F4F6F9" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12,6" Margin="0,0,10,0">
                        <TextBlock Text="WindBot Engine" FontSize="11.5" Foreground="#555555" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F4F6F9" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12,6">
                        <TextBlock x:Name="TxtTime" Text="00:00:00" FontSize="13" Foreground="#111111" FontFamily="Consolas" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (2 Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Deck Explorer (White WinForm Container) -->
            <Border Grid.Column="0" Background="#F8FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.18"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Title & Search -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Deck Library" FontSize="15" FontWeight="Bold" Foreground="#111111" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDeckTotalCount" Text="(0)" FontSize="12" Foreground="#666666" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Search Input -->
                        <Grid Grid.Column="1" HorizontalAlignment="Right" Width="260">
                            <TextBox x:Name="TxtSearch" TextChanged="TxtSearch_TextChanged" Padding="8,3" Height="30" VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="TxtSearchPlaceholder" Text="Search deck name..." IsHitTestVisible="False"
                                       Foreground="#888888" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Category Filter Chips -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbCatAll" Content="All Decks" Style="{StaticResource CategoryFilterPill}" IsChecked="True" Checked="RbCat_Checked"/>
                            <RadioButton x:Name="RbCatModern" Content="Modern" Style="{StaticResource CategoryFilterPill}" Checked="RbCat_Checked"/>
                            <RadioButton x:Name="RbCatAnime" Content="Anime" Style="{StaticResource CategoryFilterPill}" Checked="RbCat_Checked"/>
                            <RadioButton x:Name="RbCatLegacy" Content="Legacy" Style="{StaticResource CategoryFilterPill}" Checked="RbCat_Checked"/>
                            <RadioButton x:Name="RbCatGoat" Content="GOAT" Style="{StaticResource CategoryFilterPill}" Checked="RbCat_Checked"/>
                            <RadioButton x:Name="RbCatSpecial" Content="Special" Style="{StaticResource CategoryFilterPill}" Checked="RbCat_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Active Target Bot Switcher -->
                    <Border Grid.Row="2" x:Name="BotTargetSelectorBar" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Deck Target:" Foreground="#555555" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="RbAssignBot1" Content="P1 (Bot)" Style="{StaticResource BotSelectorPill}" IsChecked="True" Checked="RbAssignBot_Checked"/>
                                <RadioButton x:Name="RbAssignBot2" Content="P2 (Opponent)" Style="{StaticResource BotSelectorPill}" Visibility="Collapsed" Checked="RbAssignBot_Checked"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtDeckSelectHint" Text="Click deck to select bot" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#888888" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Deck Badges Scroll Grid (WrapPanel) -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DeckItemsHost">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="290" ItemHeight="46"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="3" CornerRadius="4" Cursor="Hand"
                                            Background="{Binding CardBackground}"
                                            BorderBrush="{Binding BorderBrushColor}"
                                            BorderThickness="{Binding BorderThicknessValue}"
                                            MouseLeftButtonDown="DeckCard_Click"
                                            MouseRightButtonDown="DeckCard_RightClick">
                                        <Grid Margin="10,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Selection indicator tag -->
                                            <Border Grid.Column="0" Visibility="{Binding IndicatorVisibility}"
                                                    Background="{Binding IndicatorBackground}" CornerRadius="3"
                                                    Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectionIndicator}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>

                                            <!-- Deck Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       Foreground="{Binding TextColor}" FontWeight="SemiBold"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <!-- Category Badge Tag -->
                                            <Border Grid.Column="2" Background="{Binding CategoryTagBg}"
                                                    CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryTagText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Selected Summary Banner -->
                    <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="4" Padding="12,8" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtSummaryBot1Label" Text="Selected Bot:" Foreground="#0284C7" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSummaryBot1" Text="None" Foreground="#111111" FontWeight="SemiBold" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" x:Name="SummaryBot2Panel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Bot 2 (P2):" Foreground="#059669" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtSummaryBot2" Text="None" Foreground="#111111" FontWeight="SemiBold" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Launcher Connection & Logs -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Connection Settings Card -->
                <Border Grid.Row="0" Background="#F8FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.18"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Connection &amp; Launch Settings" FontSize="14" FontWeight="Bold" Foreground="#111111" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Target Host IP" FontWeight="Bold" Foreground="#444444" Margin="0,0,0,4" FontSize="11.5"/>
                                <TextBox x:Name="TxtHostIp" Text="127.0.0.1" Height="30" Padding="8,4" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Port" FontWeight="Bold" Foreground="#444444" Margin="0,0,0,4" FontSize="11.5"/>
                                <TextBox x:Name="TxtHostPort" Text="7911" Height="30" Padding="8,4" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Mode:" FontWeight="Bold" Foreground="#444444" Margin="0,0,0,4" FontSize="11.5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="RbModeSingle" Content="Play vs Bot" GroupName="DuelMode" IsChecked="True" Checked="RbDuelMode_Checked" Margin="0,0,14,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RbModeDual" Content="Bot Vs Bot" GroupName="DuelMode" Checked="RbDuelMode_Checked" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Matchup Card Preview -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="4" Padding="8,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- P1 Box (Clickable) -->
                                <Border x:Name="CardBoxBot1" Grid.Column="0" Background="#EFF6FF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="4" Padding="8,6" Cursor="Hand" MouseLeftButtonDown="CardBoxBot1_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCardHeaderBot1" Text="SELECTED BOT" FontSize="9.5" FontWeight="Bold" Foreground="#0284C7"/>
                                        <TextBlock x:Name="TxtMatchupBot1" Text="Blue-Eyes" FontSize="12" FontWeight="Bold" Foreground="#111111" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtIndicatorBot1" Text="● ACTIVE" FontSize="9" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- VS Circle: Visible only in Bot Vs Bot -->
                                <Border x:Name="VsCircle" Grid.Column="1" Visibility="Collapsed" Background="#E2E8F0" CornerRadius="12" Width="24" Height="24" VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock Text="VS" FontSize="10" FontWeight="Bold" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- P2 Box: Visible only in Bot Vs Bot -->
                                <Border x:Name="CardBoxBot2" Grid.Column="2" Visibility="Collapsed" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Cursor="Hand" MouseLeftButtonDown="CardBoxBot2_Click">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="BOT 2 (P2)" FontSize="9.5" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="TxtMatchupBot2" Text="Dark Magician" FontSize="12" FontWeight="Bold" Foreground="#111111" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="TxtIndicatorBot2" Text="CLICK TO SELECT" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Button x:Name="BtnConnectAi" Content="Start &amp; Connect Bot to Room" Style="{StaticResource ClassicCharcoalBtn}" Height="38" Click="BtnConnectAi_Click"/>
                    </StackPanel>
                </Border>

                <!-- Console Logs Box -->
                <Border Grid.Row="2" Background="#F8FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.18"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Log Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Console Output Logs" FontSize="13" FontWeight="Bold" Foreground="#111111"/>
                                <CheckBox x:Name="ChkDevMode" Content="โหมดนักพัฒนา (บันทึก Logs)" IsChecked="True" FontWeight="SemiBold" FontSize="11" Foreground="#444444" Margin="14,0,0,0" VerticalAlignment="Center" Cursor="Hand" Click="ChkDevMode_Click" ToolTip="เปิด: แสดงผลและบันทึก Logs ละเอียดทั้งหมด / ปิด: ซ่อน Log ละเอียดและไม่บันทึกไฟล์ลงดิสก์"/>
                                <TextBlock x:Name="TxtConsoleStatus" Text="Ready." FontSize="11" Foreground="#059669" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnOpenLogs" Content="Open Logs" Style="{StaticResource SecondaryWhiteBtn}" Padding="10,3" Margin="0,0,6,0" Click="BtnOpenLogs_Click"/>
                                <Button x:Name="BtnCopyConsole" Content="Copy" Style="{StaticResource SecondaryWhiteBtn}" Padding="10,3" Margin="0,0,6,0" Click="BtnCopyConsole_Click"/>
                                <Button x:Name="BtnClearConsole" Content="Clear" Style="{StaticResource SecondaryWhiteBtn}" Padding="10,3" Click="BtnClearConsole_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- High performance log output (Clean White Console) -->
                        <TextBox x:Name="TxtConsole" Grid.Row="1" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="White" Foreground="#111111" FontFamily="Consolas" FontSize="11.5"
                                 Padding="8" BorderBrush="#CCCCCC" BorderThickness="1.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"/>

                        <TextBlock Grid.Row="2" Text="Rule-based ModernExecutor client strictly follows official rules." FontSize="10.5" Foreground="#666666" Margin="0,6,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer Bar -->
        <Border Grid.Row="2" Background="#F8FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="6" Padding="14,8" Margin="0,14,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="YGO Platform - Standalone Bot Runner Launcher (dashbot)" FontSize="11" Foreground="#555555" FontWeight="SemiBold"/>
                    <TextBlock Text=" | " FontSize="11" Foreground="#CCCCCC" Margin="6,0"/>
                    <TextBlock Text="WindBot by IceYgo" FontSize="11" Foreground="#0284C7" FontWeight="Bold"/>
